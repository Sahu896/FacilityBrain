__pycache__/
*.pyc

# Editor/OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local environment files if anyone adds one later (don't commit API keys)
.env

# NOTE: data/ and outputs/ are intentionally NOT excluded — this project
